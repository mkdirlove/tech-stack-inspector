{
  "manifest_version": 2,
  "name": "Tech Stack Inspector",
  "description": "Detect common web technologies used by the current website.",
  "version": "1.0.0",
  "permissions": ["activeTab", "tabs", "<all_urls>"],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Inspect website stack"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tech-stack-inspector@mkdirlove"
    }
  }
}
